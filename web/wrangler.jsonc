{
  // Configuração do Worker que serve a web (decisão 10 da E5). A Cloudflare lê
  // este arquivo no build: é aqui, e não num painel, que fica declarado o que é
  // publicado e como as rotas se comportam.
  "$schema": "node_modules/wrangler/config-schema.json",

  // O nome do Worker. Ele dá o endereço `workers.dev` e nomeia as prévias, mas
  // o endereço que as merendeiras recebem é o domínio próprio declarado em
  // `routes`, logo abaixo. Mudar isto muda as duas coisas.
  "name": "mae",

  // Congela o comportamento da plataforma na data em que o projeto foi escrito:
  // atualização futura do runtime não muda o que já está no ar sem que alguém
  // mude esta linha de propósito.
  "compatibility_date": "2026-09-14",

  // O endereço de produção. O domínio já vive na Cloudflare, e por isso ela
  // cria o registro de DNS e o certificado sozinha — não há nada a fazer no
  // painel. Fica aqui, e não lá, pela mesma razão que o resto deste arquivo:
  // endereço é coisa que se lê no repositório e se revisa num Pull Request.
  "routes": [{ "pattern": "mae.rds.dev.br", "custom_domain": true }],

  // As duas linhas abaixo são o padrão da plataforma, declaradas de propósito:
  // sem elas o Wrangler avisa em todo deploy que está decidindo sozinho.
  //
  // E há um detalhe que morde: declarar `routes` sem dizer nada sobre
  // `workers_dev` faz o Wrangler DEDUZIR `false` e derrubar o endereço
  // `workers.dev` — que é onde as prévias por branch vivem. O `true` explícito
  // é o que mantém de pé o endereço que permite mandar uma tela para as
  // merendeiras antes de ela entrar na `main`.
  "workers_dev": true,
  "preview_urls": true,

  "assets": {
    // O que o `npm run build` produz. Não há código de servidor: a web é
    // estática e conversa direto com o Supabase.
    "directory": "./dist",

    // Caminho que não corresponde a arquivo devolve o `index.html` com 200, que
    // é o que mantém de pé uma rota do React Router aberta direto na barra de
    // endereço ou recarregada com F5. Sem isto, tudo que não fosse a raiz daria
    // 404 — e só em produção, onde o servidor de desenvolvimento não está lá
    // para disfarçar.
    "not_found_handling": "single-page-application",
  },
}
