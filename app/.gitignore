# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Endereço e chave do Supabase por ambiente (issue #99) — só os .example
# entram no repositório; local.json e production.json têm a chave de
# verdade e nascem de uma cópia manual.
/env/*.json
!/env/*.example.json
